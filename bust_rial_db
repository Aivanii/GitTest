CREATE DATABASE IF NOT EXISTS company_db;
USE company_db;

CREATE TABLE employees(
    employee_id INT PRIMARY KEY AUTO_INCREMENT,
    first_name VARCHAR(25) NOT NULL,
    last_name VARCHAR(30) NOT NULL,
    patronymic VARCHAR(30),
    position VARCHAR(50) NOT NULL,
    hire_date DATE NOT NULL,
    cabinet_number VARCHAR(10),
    date_birth DATE NOT NULL,
    photo MEDIUMBLOB,
    add_information TEXT
);

CREATE TABLE customers(
    customers_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(25) NOT NULL,
    director VARCHAR(25) NOT NULL,
    account_number VARCHAR(20) NOT NULL,
    bank VARCHAR(40) NOT NULL,
    additional_info MEDIUMBLOB,
    contact_person VARCHAR(70) NOT NULL,
    telephone VARCHAR(20) NOT NULL,
    email_address VARCHAR(50) NOT NULL
);

CREATE TABLE operational_amplifiers(
    op_amp_id INT PRIMARY KEY AUTO_INCREMENT,              
    type VARCHAR(20) NOT NULL,                     
    family ENUM('LM', 'TL', 'OP', 'AD', 'LT', 'Other') NOT NULL, 
    channel_count INT UNSIGNED NOT NULL,                        
    min_supply_voltage_v DECIMAL(5,2) UNSIGNED NOT NULL,                 
    max_supply_voltage_v DECIMAL(5,2) UNSIGNED NOT NULL,                 
    unity_gain_frequency_mhz DECIMAL(10,2) UNSIGNED NOT NULL,          
    slew_rate DECIMAL(10,2) UNSIGNED NOT NULL,                      
    input_offset_voltage_mv DECIMAL(5,2) UNSIGNED NOT NULL,            
    quiescent_current DECIMAL(5,2) UNSIGNED NOT NULL,                 
    min_operating_temp_v DECIMAL(5,2) NOT NULL,                
    max_operating_temp_v DECIMAL(5,2) NOT NULL,                 
    package ENUM('DIP', 'SOIC', 'QFN', 'TQFP', 'Other') NOT NULL,  
    description TEXT,                               
    price DECIMAL(10,2) NOT NULL
);

CREATE TABLE orders(
    order_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_id INT NOT NULL,
    employee_id INT NOT NULL,
    order_date DATE NOT NULL,
    execution_date DATE,
    CONSTRAINT fk_orders_customers
        FOREIGN KEY (customer_id) REFERENCES customers(customers_id),
    CONSTRAINT fk_orders_employees
        FOREIGN KEY (employee_id) REFERENCES employees(employee_id)
);

CREATE TABLE order_details(
    order_detail_id INT PRIMARY KEY AUTO_INCREMENT, 
    order_id INT NOT NULL,  -- Исправлено имя поля для ясности
    op_amp_id INT NOT NULL,
    quantity INT NOT NULL,
    CONSTRAINT fk_orderdetails_orders
        FOREIGN KEY (order_id) REFERENCES orders(order_id), 
    CONSTRAINT fk_orderdetails_operational_amplifiers
        FOREIGN KEY (op_amp_id) REFERENCES operational_amplifiers(op_amp_id)
);

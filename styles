- кольца
<!doctype html>
<html><head><meta charset="utf-8"><style>
  html, body { margin: 0; height: 100%; background: #0d0e10;
    display: grid; place-items: center; }


  /* центральная сфера */
  .core {
    width: 90px; height: 90px;
  }

  /* внешнее кольцо */
  .orbit {
    position: absolute; inset: 8%;
    border: 1px solid rgba(218,218,208,.26);
    border-radius: 50%;
    box-shadow: 0 0 75px rgba(203,200,186,.06),
                inset 0 0 65px rgba(203,200,186,.04);
    animation: rotate 42s linear infinite;
  }
  .orbit::before, .orbit::after {
    content: "";
    position: absolute;
    inset: 13% -8%;
    border: 1px solid rgba(218,218,208,.25);
    border-radius: 50%;
    transform: rotate(58deg);
  }
  .orbit::after {
    inset: -8% 13%;
    transform: rotate(-58deg);
  }

  /* внутреннее пунктирное кольцо */
  .orbit-inner {
    position: absolute; inset: 25%;
    border: 1px dashed rgba(218,218,208,.24);
    border-radius: 50%;
    animation: rotate 28s linear infinite reverse;
  }
  .orbit-inner::before {
    content: "";
    position: absolute; width: 9px; height: 9px;
    top: 13%; left: 15%; border-radius: 50%;
    background: #d9d5c9; box-shadow: 0 0 22px #d9d5c9;
  }

  @keyframes rotate { to { transform: rotate(360deg); } }
</style></head><body>
  <div class="stage">
    <div class="orbit"><div class="orbit-inner"></div></div>
    <div class="core"></div>
  </div>
</body></html>


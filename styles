body {
  background:
        radial-gradient(ellipse at 82% 14%, rgba(170, 156, 135, .13), transparent 27%),
        radial-gradient(ellipse at 18% 48%, rgba(153, 165, 169, .09), transparent 31%),
        radial-gradient(ellipse at 72% 83%, rgba(190, 190, 182, .07), transparent 25%),
        linear-gradient(135deg, #08090a, #141517 48%, #090a0b);
  
  background-attachment: fixed; /* Чтобы фон не прокручивался */
}
 

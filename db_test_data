-- 7. КРАСИВЫЕ ОТЧЕТЫ
SELECT '=== ОБЩИЙ ОТЧЕТ ПО ЗАКАЗАМ ===' as '';
SELECT 
    o.order_id,
    c.name as client_name,
    CONCAT(e.surname, ' ', e.name) as employee_name,
    o.order_date,
    o.execution_date,
    COUNT(od.order_detail_id) as items_count,
    SUM(od.quantity) as total_quantity
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
LEFT JOIN employees e ON o.employee_id = e.employee_id
JOIN order_details od ON o.order_id = od.order_id
GROUP BY o.order_id
ORDER BY o.order_date;

SELECT '=== ДЕТАЛИЗАЦИЯ ЗАКАЗОВ ===' as '';
SELECT 
    o.order_id,
    c.name as client_name,
    op.type as amplifier_type,
    op.family,
    od.quantity,
    op.price,
    ROUND(od.quantity * op.price, 2) as total_price
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
JOIN order_details od ON o.order_id = od.order_id
JOIN operational_amplifiers op ON od.operational_amplifier_id = op.operational_amplifier_id
ORDER BY o.order_id, od.order_detail_id;

SELECT '=== ТОП ТОВАРОВ ПО ПРОДАЖАМ ===' as '';
SELECT 
    op.type,
    op.family,
    SUM(od.quantity) as total_sold,
    COUNT(DISTINCT o.order_id) as orders_count
FROM operational_amplifiers op
JOIN order_details od ON op.operational_amplifier_id = od.operational_amplifier_id
JOIN orders o ON od.order_id = o.order_id
GROUP BY op.operational_amplifier_id
ORDER BY total_sold DESC;

-- 8. ПРОВЕРКА СВЯЗЕЙ (FOREIGN KEY работают!)
SELECT '=== ПРОВЕРКА СВЯЗЕЙ ===' as '';
SELECT 
    'Клиенты без заказов' as check_type,
    COUNT(*) as count
FROM customers c
LEFT JOIN orders o ON c.customer_id = o.customer_id
WHERE o.order_id IS NULL

UNION ALL

SELECT 
    'Сотрудники без заказов',
    COUNT(*)
FROM employees e
LEFT JOIN orders o ON e.employee_id = o.employee_id
WHERE o.order_id IS NULL

UNION ALL

SELECT 
    'Товары без продаж',
    COUNT(*)
FROM operational_amplifiers op
LEFT JOIN order_details od ON op.operational_amplifier_id = od.operational_amplifier_id
WHERE od.order_detail_id IS NULL;

-- with no CHECK OPTION
CREATE OR REPLACE VIEW view_employees_male_over35 AS
SELECT *
FROM employees
WHERE gender = 'M' AND TIMESTAMPDIFF(YEAR, birth_date, CURDATE()) > 35;

-- with CHECK OPTION
CREATE OR REPLACE VIEW view_employees_male_over35_check AS
SELECT *
FROM employees
WHERE gender = 'M' AND TIMESTAMPDIFF(YEAR, birth_date, CURDATE()) > 35
WITH CHECK OPTION;

-- 15 --
DELIMITER //
CREATE TRIGGER check_order_completion
AFTER INSERT ON shipment
FOR EACH ROW
BEGIN
    DECLARE done INT DEFAULT FALSE;
    DECLARE order_item_id_var INT;
    DECLARE order_id_var INT;
    DECLARE chip_id_var INT;
    DECLARE ordered_qty INT;
    DECLARE shipped_qty INT;
    DECLARE all_completed BOOLEAN DEFAULT TRUE;
    
    DECLARE order_items_cursor CURSOR FOR
        SELECT oi.order_item_id, oi.order_id, oi.chip_id, oi.quantity
        FROM order_items oi
        WHERE oi.order_id = NEW.order_id;
    
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
    
    OPEN order_items_cursor;
    
    order_loop: LOOP
        FETCH order_items_cursor INTO order_item_id_var, order_id_var, chip_id_var, ordered_qty;
        IF done THEN
            LEAVE order_loop;
        END IF;
        
        SELECT COALESCE(SUM(quantity), 0) INTO shipped_qty
        FROM shipment
        WHERE order_id = order_id_var AND chip_id = chip_id_var;
        
        IF shipped_qty < ordered_qty THEN
            SET all_completed = FALSE;
            LEAVE order_loop;
        END IF;
    END LOOP;
    
    CLOSE order_items_cursor;
    
    IF all_completed THEN
        UPDATE orders 
        SET completion_date = CURDATE() 
        WHERE order_id = NEW.order_id AND completion_date IS NULL;
    END IF;
END //
DELIMITER ;

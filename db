DROP TABLE IF EXISTS shipment;
DROP TABLE IF EXISTS order_items;
DROP TABLE IF EXISTS receipt;
DROP TABLE IF EXISTS supplier_chips;
DROP TABLE IF EXISTS suppliers;
DROP TABLE IF EXISTS chips;
DROP TABLE IF EXISTS manager;
DROP TABLE IF EXISTS orders;

CREATE TABLE manager(
    manager_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(15) NOT NULL,
    surname VARCHAR(20) NOT NULL,
    patronymic VARCHAR(20),
    email VARCHAR(50) NOT NULL UNIQUE,
    tel VARCHAR(20) NOT NULL UNIQUE,
    CONSTRAINT chk_tel_format CHECK (tel REGEXP '^\\+7\\([0-9]{3}\\)[0-9]{3}-[0-9]{2}-[0-9]{2}$'),
    CONSTRAINT chk_email_format CHECK (email REGEXP '^[^@]+@[^@]+\\.[^@]{2,}$')
);

CREATE TABLE chips(
    chip_id INT AUTO_INCREMENT PRIMARY KEY,
    chip_name VARCHAR(50) NOT NULL UNIQUE,
    type VARCHAR(30) NOT NULL,
    price DECIMAL(10,2) NOT NULL CHECK (price > 0),
    technical_specifications TEXT,
    created_date DATE DEFAULT CURDATE()
);

CREATE TABLE suppliers(
    supplier_id INT AUTO_INCREMENT PRIMARY KEY,
    company_name VARCHAR(70) NOT NULL UNIQUE,
    director VARCHAR(100) NOT NULL,
    address VARCHAR(500) NOT NULL,
    contact_person VARCHAR(100) NOT NULL,
    phone VARCHAR(20) NOT NULL UNIQUE,
    email VARCHAR(100) NOT NULL UNIQUE,
    manager_id INT,
    INDEX idx_company_name (company_name),
    CONSTRAINT chk_supplier_email CHECK (email REGEXP '^[^@]+@[^@]+\\.[^@]{2,}$'),
    CONSTRAINT fk_supplier_manager_id
    FOREIGN KEY (manager_id) REFERENCES manager (manager_id)
    ON DELETE SET NULL
    ON UPDATE CASCADE
);

ALTER TABLE suppliers
ADD INDEX idx_director (director);

ALTER TABLE suppliers
ADD CONSTRAINT chk_supplier_phone CHECK (phone REGEXP '^\\+7\\([0-9]{3}\\)[0-9]{3}-[0-9]{2}-[0-9]{2}$');

CREATE TABLE supplier_chips(
    supplier_chip_id INT AUTO_INCREMENT PRIMARY KEY,
    supplier_id INT NOT NULL,
    chip_id INT NOT NULL,
    supply_price DECIMAL(10,2),
    min_order_quantity INT DEFAULT 1 CHECK (min_order_quantity > 0),
    delivery_time_days INT DEFAULT 7 CHECK (delivery_time_days > 0),
    UNIQUE KEY unique_supplier_chip (supplier_id, chip_id),
    CONSTRAINT fk_supplier_chips_supplier
    FOREIGN KEY (supplier_id) REFERENCES suppliers(supplier_id)
    ON DELETE CASCADE
    ON UPDATE CASCADE,
    CONSTRAINT fk_supplier_chips_chip
    FOREIGN KEY (chip_id) REFERENCES chips(chip_id)
    ON DELETE CASCADE
    ON UPDATE CASCADE,
    INDEX idx_supplier_id (supplier_id),
    INDEX idx_chip_id (chip_id)
);

CREATE TABLE orders(
    order_id INT AUTO_INCREMENT PRIMARY KEY,
    order_date DATE NOT NULL,
    completion_date DATE NULL,
    employee_id INT NOT NULL,
    customer_name VARCHAR(100) NOT NULL,
    total_amount DECIMAL(10,2) DEFAULT 0
);

CREATE TABLE order_items(
    order_item_id INT AUTO_INCREMENT PRIMARY KEY,
    order_id INT NOT NULL,
    chip_id INT NOT NULL,
    quantity INT NOT NULL CHECK (quantity > 0),
    unit_price DECIMAL(10,2) NOT NULL CHECK (unit_price > 0),
    total_price DECIMAL(15,2) AS (quantity * unit_price),
    INDEX idx_order_id (order_id),
    INDEX idx_chip_id (chip_id),
    CONSTRAINT fk_order_items_order
    FOREIGN KEY (order_id) REFERENCES orders(order_id)
    ON DELETE CASCADE
    ON UPDATE CASCADE,
    CONSTRAINT fk_order_items_chip
    FOREIGN KEY (chip_id) REFERENCES chips(chip_id)
    ON DELETE RESTRICT
    ON UPDATE CASCADE
);

CREATE TABLE receipt(
    receipt_id INT AUTO_INCREMENT PRIMARY KEY,
    receipt_invoice VARCHAR(50) NOT NULL UNIQUE,
    supplier_id INT NOT NULL,
    date DATE NOT NULL,
    chip_id INT NOT NULL,
    price DECIMAL(10,2) NOT NULL CHECK (price > 0),
    quantity INT NOT NULL CHECK (quantity > 0),
    INDEX idx_supplier_id (supplier_id),
    INDEX idx_chip_id (chip_id),
    INDEX idx_date (date),
    CONSTRAINT fk_receipt_supplier
    FOREIGN KEY (supplier_id) REFERENCES suppliers(supplier_id)
    ON DELETE RESTRICT
    ON UPDATE CASCADE,
    CONSTRAINT fk_receipt_chip
    FOREIGN KEY (chip_id) REFERENCES chips(chip_id)
    ON DELETE RESTRICT
    ON UPDATE CASCADE
);

CREATE TABLE shipment(
    shipment_id INT AUTO_INCREMENT PRIMARY KEY,
    shipment_invoice VARCHAR(50) NOT NULL UNIQUE,
    order_id INT NOT NULL,
    date DATE NOT NULL,
    chip_id INT NOT NULL,
    quantity INT NOT NULL CHECK (quantity > 0),
    INDEX idx_order_id (order_id),
    INDEX idx_chip_id (chip_id),
    INDEX idx_shipment_date (date),
    CONSTRAINT fk_shipment_chip
    FOREIGN KEY (chip_id) REFERENCES chips(chip_id)
    ON DELETE RESTRICT
    ON UPDATE CASCADE
);

-- 1 --
SELECT 
    o.order_id AS 'order_id',
    o.customer_name AS 'customer_name',
    COUNT(*) AS 'number of orders'
FROM orders o
WHERE o.customer_name = 'ЗАО Электроник'
GROUP BY o.order_id, o.customer_name;

-- 2 -- 
-- stockpiling --
SELECT 
    c.type AS 'type',
    COALESCE(SUM(r.quantity), 0) AS 'quantity'
FROM chips c
LEFT JOIN receipt r ON c.chip_id = r.chip_id
GROUP BY c.type;

-- Delivery from warehouse --
SELECT 
    c.type AS 'type',
    COALESCE(SUM(s.quantity), 0) AS 'quantity'
FROM chips c
LEFT JOIN shipment s ON c.chip_id = s.chip_id
GROUP BY c.type;

-- 3 --
CREATE TEMPORARY TABLE temp_receipt AS
SELECT 
    c.type,
    COALESCE(SUM(r.quantity), 0) AS received_qty
FROM chips c
LEFT JOIN receipt r ON c.chip_id = r.chip_id
GROUP BY c.type;

CREATE TEMPORARY TABLE temp_shipment AS
SELECT 
    c.type,
    COALESCE(SUM(s.quantity), 0) AS shipped_qty
FROM chips c
LEFT JOIN shipment s ON c.chip_id = s.chip_id
GROUP BY c.type;

CREATE TEMPORARY TABLE temp_stock AS
SELECT 
    r.type,
    (r.received_qty - COALESCE(s.shipped_qty, 0)) AS stock_qty
FROM temp_receipt r
LEFT JOIN temp_shipment s ON r.type = s.type;

SELECT * FROM temp_stock;

-- 4 --
CREATE OR REPLACE VIEW view_receipt AS
SELECT 
    c.type,
    COALESCE(SUM(r.quantity), 0) AS received_quantity
FROM chips c
LEFT JOIN receipt r ON c.chip_id = r.chip_id
GROUP BY c.type;

CREATE OR REPLACE VIEW view_shipment AS
SELECT 
    c.type,
    COALESCE(SUM(s.quantity), 0) AS shipped_quantity
FROM chips c
LEFT JOIN shipment s ON c.chip_id = s.chip_id
GROUP BY c.type;

CREATE OR REPLACE VIEW view_stock AS
SELECT 
    r.type,
    (r.received_quantity - s.shipped_quantity) AS stock_quantity
FROM view_receipt r
JOIN view_shipment s ON r.type = s.type;

-- 5 -- 
SELECT stock_quantity 
FROM view_stock 
WHERE type = 'chip_type';

-- 6 --
CREATE OR REPLACE VIEW view_order_cost AS
SELECT 
    o.order_id AS 'order_id',
    o.customer_name AS 'customer_name',
    o.order_date AS 'order_date',
    SUM(oi.quantity * oi.unit_price) AS 'price'
FROM orders o
JOIN order_items oi ON o.order_id = oi.order_id
GROUP BY o.order_id, o.customer_name, o.order_date;

-- 7 --
DELIMITER //
CREATE PROCEDURE calculate_revenue_period(
    IN start_date DATE,
    IN end_date DATE,
    OUT total_revenue DECIMAL(15,2)
)
BEGIN
    SELECT COALESCE(SUM(oi.quantity * oi.unit_price), 0) INTO total_revenue
    FROM orders o
    JOIN order_items oi ON o.order_id = oi.order_id
    WHERE o.order_date BETWEEN start_date AND end_date;
END //
DELIMITER ;

-- 8 --
DELIMITER //
CREATE PROCEDURE check_chip_in_order(
    IN order_id_param INT,
    IN chip_type_param VARCHAR(30),
    OUT exists_flag BOOLEAN
)
BEGIN
    DECLARE chip_count INT;
    
    SELECT COUNT(*) INTO chip_count
    FROM order_items oi
    JOIN chips c ON oi.chip_id = c.chip_id
    WHERE oi.order_id = order_id_param AND c.type = chip_type_param;
    
    SET exists_flag = (chip_count > 0);
END //
DELIMITER ;

-- 9 --
DELIMITER //
CREATE TRIGGER before_shipment_insert
BEFORE INSERT ON shipment
FOR EACH ROW
BEGIN
    DECLARE chip_exists BOOLEAN;
    
    CALL check_chip_in_order(NEW.order_id, 
        (SELECT type FROM chips WHERE chip_id = NEW.chip_id), 
        chip_exists);
    
    IF NOT chip_exists THEN
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Error: There is no any chip in the order';
    END IF;
END //

CREATE TRIGGER before_shipment_update
BEFORE UPDATE ON shipment
FOR EACH ROW
BEGIN
    DECLARE chip_exists BOOLEAN;
    
    CALL check_chip_in_order(NEW.order_id, 
        (SELECT type FROM chips WHERE chip_id = NEW.chip_id), 
        chip_exists);
    
    IF NOT chip_exists THEN
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Error: There is no any chip in the order';
    END IF;
END //
DELIMITER ;

-- 10 --
DELIMITER //
CREATE PROCEDURE calculate_remaining_shipment(
    IN order_id_param INT,
    IN chip_type_param VARCHAR(30),
    OUT remaining_qty INT
)
BEGIN
    DECLARE ordered_qty INT;
    DECLARE shipped_qty INT;
    
    -- number of ordered chips --
    SELECT COALESCE(SUM(oi.quantity), 0) INTO ordered_qty
    FROM order_items oi
    JOIN chips c ON oi.chip_id = c.chip_id
    WHERE oi.order_id = order_id_param AND c.type = chip_type_param;
    
    -- number of shipped chips -- 
    SELECT COALESCE(SUM(s.quantity), 0) INTO shipped_qty
    FROM shipment s
    JOIN chips c ON s.chip_id = c.chip_id
    WHERE s.order_id = order_id_param AND c.type = chip_type_param;
    
    SET remaining_qty = GREATEST(ordered_qty - shipped_qty, 0);
END //
DELIMITER ;

-- 11 --
DELIMITER //
CREATE TRIGGER before_shipment_insert_qty
BEFORE INSERT ON shipment
FOR EACH ROW
BEGIN
    DECLARE remaining_qty INT;
    DECLARE chip_type VARCHAR(30);
    
    SELECT type INTO chip_type FROM chips WHERE chip_id = NEW.chip_id;
    
    CALL calculate_remaining_shipment(NEW.order_id, chip_type, remaining_qty);
    
    IF NEW.quantity > remaining_qty THEN
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Error: the number of the shipment is bigger than the rest of the order';
    END IF;
END //

CREATE TRIGGER before_shipment_update_qty
BEFORE UPDATE ON shipment
FOR EACH ROW
BEGIN
    DECLARE remaining_qty INT;
    DECLARE chip_type VARCHAR(30);
    
    SELECT type INTO chip_type FROM chips WHERE chip_id = NEW.chip_id;
    
    CALL calculate_remaining_shipment(NEW.order_id, chip_type, remaining_qty);
    
    IF NEW.quantity > remaining_qty THEN
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Error: the number of the shipment is bigger than the rest of the order';
     END IF;
END //
DELIMITER ;

-- 12 --
DELIMITER //
CREATE PROCEDURE get_stock_by_type(
    IN chip_type_param VARCHAR(30),
    OUT stock_quantity INT
)
BEGIN
    SELECT COALESCE(stock_quantity, 0) INTO stock_quantity
    FROM view_stock
    WHERE type = chip_type_param;
END //
DELIMITER ;

-- 13 --
DELIMITER //
CREATE TRIGGER before_shipment_stock
BEFORE INSERT ON shipment
FOR EACH ROW
BEGIN
    DECLARE current_stock INT;
    DECLARE chip_type VARCHAR(30);
    
    SELECT type INTO chip_type FROM chips WHERE chip_id = NEW.chip_id;
    CALL get_stock_by_type(chip_type, current_stock);
    
    IF current_stock <= 0 THEN
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Error: there is not enough chips in stock';
    END IF;
END //
DELIMITER ;


CREATE DATABASE IF NOT EXISTS company_db;
USE company_db;

CREATE TABLE operational_amplifiers (
    operational_amplifier_id INT PRIMARY KEY AUTO_INCREMENT,
    type VARCHAR(20) NOT NULL,
    family ENUM('JFET', 'CMOS', 'Bipolar', 'BiFET') NOT NULL, 
    channel_count TINYINT UNSIGNED NOT NULL,
    min_supply_voltage_v DECIMAL(5,2) UNSIGNED, 
    max_supply_voltage_v DECIMAL(5,2) UNSIGNED, 
    unity_gain_frequency_mhz DECIMAL(6,2) UNSIGNED,
    slew_rate_v_per_us DECIMAL(5,2) UNSIGNED,
    input_offset_voltage_mv DECIMAL(5,2) UNSIGNED, 
    quiescent_current_ma DECIMAL(6,2) UNSIGNED,
    min_operating_temperature_c TINYINT, 
    max_operating_temperature_c TINYINT, 
    package ENUM('SOIC-8', 'SOIC-14', 'DIP-8', 'PDIP-8', 'SOT-23-5', 'SOT-23-6', 
             'QFN-16', 'TSSOP-14', 'MSOP-8', 'LFCSP') NOT NULL, 
    description VARCHAR(150),
    price DECIMAL(5,2) UNSIGNED
);

CREATE TABLE customers(
    customer_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(30) NOT NULL,
    manager VARCHAR(70) NOT NULL,
    account_number VARCHAR(20) NOT NULL,
    bank VARCHAR(40) NOT NULL,
    additional_info MEDIUMBLOB,
    contact_person VARCHAR(70) NOT NULL,
    phone VARCHAR(20) NOT NULL, 
    email VARCHAR(50) NOT NULL
);

CREATE TABLE employees(
    employee_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(20) NOT NULL,
    surname VARCHAR(30) NOT NULL,
    patronymic VARCHAR(20) NOT NULL,
    gender ENUM('М', 'Ж', 'НБ', 'Х'),
    position VARCHAR(50) NOT NULL,
    start_date DATE NOT NULL,
    cabinet_number VARCHAR(5),
    birthdate DATE NOT NULL,
    profile_picture MEDIUMBLOB,
    additional_info TEXT
);

CREATE TABLE orders(
    order_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_id INT NOT NULL,
    employee_id INT,
    order_date DATE NOT NULL,
    execution_date DATE,
    
    CONSTRAINT fk_orders_customer 
        FOREIGN KEY (customer_id) REFERENCES customers(customer_id),
        
    CONSTRAINT fk_orders_employee 
        FOREIGN KEY (employee_id) REFERENCES employees(employee_id)
);

CREATE TABLE order_details(
    order_detail_id INT PRIMARY KEY AUTO_INCREMENT,
    order_id INT NOT NULL,
    operational_amplifier_id INT NOT NULL,
    quantity INT NOT NULL,
    
    CONSTRAINT fk_order_details_order 
        FOREIGN KEY (order_id) REFERENCES orders(order_id),
        
    CONSTRAINT fk_order_details_amplifier 
        FOREIGN KEY (operational_amplifier_id) REFERENCES operational_amplifiers(operational_amplifier_id)
);

CREATE INDEX idx_price ON operational_amplifiers(price);
CREATE INDEX idx_quiescent_current_ma ON operational_amplifiers(quiescent_current_ma);
CREATE INDEX idx_channels_frequency ON operational_amplifiers(channels, unity_gain_frequency_mhz);

CREATE INDEX idx_customer_name ON customers(name);
CREATE INDEX idx_contact_person ON customers(contact_person);

CREATE INDEX idx_employee_surname ON employees(surname);
CREATE INDEX idx_employee_birthdate ON employees(birthdate);

CREATE INDEX idx_customer_id ON orders(customer_id);
CREATE INDEX idx_employee_id ON orders(employee_id);

CREATE DATABASE IF NOT EXISTS company_db;

CREATE TABLE company_db.operational_amplifiers (
    operational_amplifier_id INT PRIMARY KEY AUTO_INCREMENT,
    type VARCHAR(20) NOT NULL,
    family ENUM('JFET', 'CMOS', 'Bipolar', 'BiFET') NOT NULL, 
    channels TINYINT UNSIGNED NOT NULL,
    min_supply_voltage_v DECIMAL(4,2) UNSIGNED, 
    max_supply_voltage_v DECIMAL(4,2) UNSIGNED, 
    unity_gain_frequency_mhz DECIMAL(6,2) UNSIGNED,
    slew_rate_v_per_us DECIMAL(5,2) UNSIGNED,
    input_offset_voltage_mv DECIMAL(5,2) UNSIGNED, 
    quiescent_current_ma DECIMAL(6,2) UNSIGNED,
    min_operating_temperature_c TINYINT, 
    max_operating_temperature_c TINYINT UNSIGNED, 
    chip_package ENUM('SOIC-8', 'DIP-8', 'SOT-23-5', 'QFN') NOT NULL, 
    description VARCHAR(150),
    price DECIMAL(5,2) UNSIGNED
);

CREATE INDEX idx_price ON company_db.operational_amplifiers(price);
CREATE INDEX idx_quiescent_current_ma ON company_db.operational_amplifiers(quiescent_current_ma);
CREATE INDEX idx_channels_frequency ON company_db.operational_amplifiers(channels, unity_gain_frequency_mhz);

CREATE TABLE company_db.customers(
    customer_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(30) NOT NULL,
    manager VARCHAR(70) NOT NULL,
    account_number VARCHAR(20) NOT NULL,
    bank VARCHAR(40),
    additional_info MEDIUMBLOB,
    contact_person VARCHAR(70),
    phone VARCHAR(20) NOT NULL, 
    email VARCHAR(100) NOT NULL
);

CREATE INDEX idx_customer_name ON company_db.customers(name);
CREATE INDEX idx_contact_person ON company_db.customers(contact_person);

CREATE TABLE company_db.employees(
    employee_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(20) NOT NULL,
    surname VARCHAR(30) NOT NULL,
    patronymic VARCHAR(20) NOT NULL,
    sex ENUM('М', 'Ж') NOT NULL,
    position VARCHAR(50) NOT NULL,
    start_date DATE NOT NULL,
    cabinet_number VARCHAR(5),
    birthdate DATE NOT NULL,
    profile_picture MEDIUMBLOB,
    additional_info TEXT
);

CREATE INDEX idx_employee_surname ON company_db.employees(surname);
CREATE INDEX idx_employee_birthdate ON company_db.employees(birthdate); 

CREATE TABLE company_db.orders(
    order_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_id INT NOT NULL,
    employee_id INT,
    order_date DATE NOT NULL,
    execution_date DATE
);

CREATE INDEX idx_customer_id ON company_db.orders(customer_id);
CREATE INDEX idx_employee_id ON company_db.orders(employee_id);

CREATE TABLE company_db.order_details(
    order_detail_id INT PRIMARY KEY AUTO_INCREMENT,
    order_id INT NOT NULL,
    operational_amplifier_id INT NOT NULL,
    quantity INT NOT NULL
);

